---
import Base from "../layouts/Base.astro";
import { stocks } from "../data/nse-stocks";

const defaultStock = stocks.find((s) => s.symbol === "INFY") ?? stocks[0];
---

<Base
  title="Investing · Vivek Raj"
  description="A quick SWOT and technical snapshot of stocks I follow, via Trendlyne."
>
  <article class="investing">
    <h1>Investing</h1>
    <p>
      A SWOT and technical snapshot for stocks I keep an eye on, via
      <a href="https://trendlyne.com/" target="_blank" rel="noopener noreferrer">Trendlyne</a>. Search
      for a stock below to load its widgets.
    </p>

    <label class="investing__picker-label" for="stock-search">Stock</label>
    <div class="investing__combobox">
      <input
        id="stock-search"
        class="investing__picker"
        type="text"
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="false"
        aria-controls="stock-options"
        aria-autocomplete="list"
        placeholder="Type a company name or symbol..."
        value={`${defaultStock.name} (${defaultStock.symbol})`}
      />
      <ul id="stock-options" class="investing__options" role="listbox" hidden></ul>
    </div>

    <div class="investing__widget">
      <h2>SWOT</h2>
      <div id="swot-widget"></div>
      <a id="swot-widget-link" class="investing__widget-link" target="_blank" rel="noopener noreferrer">
        View on Trendlyne ↗
      </a>
    </div>
    <div class="investing__widget">
      <h2>Technical Analysis</h2>
      <div id="technical-widget"></div>
      <a id="technical-widget-link" class="investing__widget-link" target="_blank" rel="noopener noreferrer">
        View on Trendlyne ↗
      </a>
    </div>
    <div class="investing__widget">
      <h2>Checklist</h2>
      <div id="checklist-widget"></div>
      <a id="checklist-widget-link" class="investing__widget-link" target="_blank" rel="noopener noreferrer">
        View on Trendlyne ↗
      </a>
    </div>

    <h2>IPOs</h2>
    <p>Upcoming, open, and recent IPOs — not tied to the stock picker above.</p>
    <div class="investing__widget">
      <div id="ipo-widget"></div>
      <a id="ipo-widget-link" class="investing__widget-link" target="_blank" rel="noopener noreferrer">
        View on Trendlyne ↗
      </a>
    </div>

    <p class="investing__note">
      Widget not showing? Some browsers (Safari on iPhone/iPad in particular, with "Prevent
      Cross-Site Tracking" on) block embedded third-party widgets like this one — use the "View on
      Trendlyne" link above instead.
    </p>
  </article>
</Base>

<script>
  import { stocks, type Stock } from "../data/nse-stocks";

  const WIDGET_PARAMS = "posCol=00A25B&primaryCol=006AFF&negCol=EB3B00&neuCol=F7941E";

  const widgets: { kind: string; containerId: string; linkId: string }[] = [
    { kind: "swot-widget", containerId: "swot-widget", linkId: "swot-widget-link" },
    { kind: "technical-widget", containerId: "technical-widget", linkId: "technical-widget-link" },
    { kind: "checklist-widget", containerId: "checklist-widget", linkId: "checklist-widget-link" },
  ];

  function widgetUrl(kind: string, symbol: string): string {
    return `https://trendlyne.com/web-widget/${kind}/Poppins/${symbol}/?${WIDGET_PARAMS}`;
  }

  const IPO_WIDGET_URL =
    "https://trendlyne.com/web-widget/ipo-widget/Poppins/?activeCol=006AFF&linksCol=006CFF&primary=202020&secondary=666666&positive=00a25b&negative=ff4e54";

  // Trendlyne's tl-widgets.js scans the page for `.trendlyne-widgets`
  // blockquotes on script load and swaps each one for the real widget.
  // To re-render for a newly picked stock, swap in a fresh, unprocessed
  // blockquote and re-insert a fresh <script> tag -- inserting a new
  // script element re-runs its top-level code even though the file
  // itself is cached, which re-triggers that DOM scan.
  function renderWidgets(symbol: string) {
    for (const { kind, containerId, linkId } of widgets) {
      const url = widgetUrl(kind, symbol);

      const container = document.getElementById(containerId);
      if (container) {
        container.innerHTML = "";
        const blockquote = document.createElement("blockquote");
        blockquote.className = "trendlyne-widgets";
        blockquote.setAttribute("data-get-url", url);
        blockquote.setAttribute("data-theme", "light");
        container.appendChild(blockquote);
      }

      const link = document.getElementById(linkId) as HTMLAnchorElement | null;
      if (link) link.href = url;
    }

    const script = document.createElement("script");
    script.async = true;
    script.src = "https://cdn-static.trendlyne.com/static/js/webwidgets/tl-widgets.js";
    document.body.appendChild(script);
  }

  // IPO widget isn't tied to a stock, so it's rendered once and never
  // touched again by the stock picker.
  function renderIpoWidget() {
    const container = document.getElementById("ipo-widget");
    if (container) {
      container.innerHTML = "";
      const blockquote = document.createElement("blockquote");
      blockquote.className = "trendlyne-widgets";
      blockquote.setAttribute("data-get-url", IPO_WIDGET_URL);
      blockquote.setAttribute("data-theme", "light");
      container.appendChild(blockquote);
    }

    const link = document.getElementById("ipo-widget-link") as HTMLAnchorElement | null;
    if (link) link.href = IPO_WIDGET_URL;

    const script = document.createElement("script");
    script.async = true;
    script.src = "https://cdn-static.trendlyne.com/static/js/webwidgets/tl-widgets.js";
    document.body.appendChild(script);
  }

  // --- Searchable combobox -------------------------------------------
  const input = document.getElementById("stock-search") as HTMLInputElement | null;
  const optionsList = document.getElementById("stock-options") as HTMLUListElement | null;

  function label(s: Stock): string {
    return `${s.name} (${s.symbol})`;
  }

  function matches(s: Stock, query: string): boolean {
    const q = query.trim().toLowerCase();
    if (!q) return true;
    return s.symbol.toLowerCase().includes(q) || s.name.toLowerCase().includes(q);
  }

  function closeOptions() {
    if (!optionsList || !input) return;
    optionsList.hidden = true;
    optionsList.innerHTML = "";
    input.setAttribute("aria-expanded", "false");
  }

  function selectStock(s: Stock) {
    if (!input) return;
    input.value = label(s);
    closeOptions();
    renderWidgets(s.symbol);
  }

  function openOptions(query: string) {
    if (!optionsList || !input) return;
    const results = stocks.filter((s) => matches(s, query)).slice(0, 25);
    optionsList.innerHTML = "";

    if (results.length === 0) {
      const li = document.createElement("li");
      li.className = "investing__option investing__option--empty";
      li.textContent = "No matching stock";
      optionsList.appendChild(li);
    } else {
      for (const s of results) {
        const li = document.createElement("li");
        li.className = "investing__option";
        li.setAttribute("role", "option");
        li.tabIndex = -1;
        li.textContent = label(s);
        li.addEventListener("mousedown", (e) => {
          // mousedown (not click) so this fires before the input's blur
          e.preventDefault();
          selectStock(s);
        });
        optionsList.appendChild(li);
      }
    }

    optionsList.hidden = false;
    input.setAttribute("aria-expanded", "true");
  }

  if (input && optionsList) {
    input.addEventListener("focus", () => openOptions(""));
    input.addEventListener("input", () => openOptions(input.value));
    input.addEventListener("blur", () => closeOptions());

    input.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        closeOptions();
        return;
      }
      if (e.key === "Enter") {
        const first = optionsList.querySelector(".investing__option:not(.investing__option--empty)");
        if (first) {
          e.preventDefault();
          (first as HTMLElement).dispatchEvent(new MouseEvent("mousedown"));
        }
        return;
      }
      if (e.key === "ArrowDown" && optionsList.hidden) {
        openOptions(input.value);
      }
    });

    // Initial render for the default stock shown in the input.
    const initialSymbol = stocks.find((s) => s.symbol === "INFY")?.symbol ?? stocks[0]?.symbol;
    if (initialSymbol) renderWidgets(initialSymbol);
    renderIpoWidget();
  }
</script>
