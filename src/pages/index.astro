---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import TagCloud from "../components/TagCloud.astro";
import ArchiveCalendar from "../components/ArchiveCalendar.astro";
import MusicPlayer from "../components/MusicPlayer.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const latestPosts = posts.slice(0, 3);
---

<Base title="Vivek's Weblog" description="Personal blog: R, Python, Haskell, and Julia code examples that run inline in the browser." wide>
  <div class="home-layout">
    <div>
      <section class="hero">
        <div class="hero__glow" aria-hidden="true"></div>
        <h1 class="hero__title">Hi, I'm Vivek Raj 👋</h1>
        <p class="hero__tagline">
          Data Science &amp; Deep Learning enthusiast. I write about R, Python, Haskell, and Julia —
          with code examples you can run right here in the browser, no setup required.
        </p>
        <div class="hero__cta">
          <a href="/blog/" class="button button--primary">Read the blog</a>
          <a href="/about/" class="button button--secondary">About me</a>
        </div>
      </section>

      <section>
        <div class="section-heading">
          <h2>Latest posts</h2>
          <a href="/blog/">View all →</a>
        </div>
        <div class="post-list">
          {latestPosts.map((post) => <PostCard post={post} />)}
        </div>
      </section>
    </div>

    <aside class="home-sidebar">
      <TagCloud />
      <ArchiveCalendar />
      <MusicPlayer />
    </aside>
  </div>
</Base>
