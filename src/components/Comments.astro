<section class="comments">
  <h2 class="comments__heading">Comments</h2>
  <script
    src="https://giscus.app/client.js"
    data-repo="vivek2606/vivek2606.github.io"
    data-repo-id="R_kgDOUES71A"
    data-category-id="DIC_kwDOUES71M4DEM7K"
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="top"
    data-theme="preferred_color_scheme"
    data-lang="en"
    crossorigin="anonymous"
    async
  ></script>
</section>

<script>
  function currentTheme(): "light" | "dark" {
    const explicit = document.documentElement.getAttribute("data-theme");
    if (explicit === "light" || explicit === "dark") return explicit;
    return matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  }

  function syncGiscusTheme() {
    const iframe = document.querySelector<HTMLIFrameElement>("iframe.giscus-frame");
    iframe?.contentWindow?.postMessage(
      { giscus: { setConfig: { theme: currentTheme() } } },
      "https://giscus.app",
    );
  }

  // The toggle button lives in Navbar.astro and flips data-theme on click;
  // give it a tick to run before reading the new value back out.
  document.addEventListener("click", (event) => {
    if (!(event.target as HTMLElement).closest("#theme-toggle")) return;
    setTimeout(syncGiscusTheme, 0);
  });

  // giscus posts a message once its iframe has finished loading a
  // discussion — that's the reliable point to push our real theme,
  // since data-theme="preferred_color_scheme" only knows the OS setting.
  window.addEventListener("message", (event) => {
    if (event.origin !== "https://giscus.app") return;
    if (!(event.data as { giscus?: { discussion?: unknown } })?.giscus?.discussion) return;
    syncGiscusTheme();
  });
</script>
