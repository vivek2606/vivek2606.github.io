---
interface Props {
  date: Date;
  author: string;
  readingTime: number;
}
const { date, author, readingTime } = Astro.props;
---

<p class="post-meta">
  {
    date.toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  }
  {" · "}
  {author}
  {" · "}
  {readingTime} min read
</p>
