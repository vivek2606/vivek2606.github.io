---
interface Props {
  tags: string[];
}
const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="tag-pills">
      {tags.map((tag) => (
        <li>
          <a href={`/blog/?tag=${encodeURIComponent(tag)}`} class="tag-pill">
            {tag}
          </a>
        </li>
      ))}
    </ul>
  )
}
