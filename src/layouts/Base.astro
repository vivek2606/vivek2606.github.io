---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import CopyCodeButtons from "../components/CopyCodeButtons.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  image?: string;
  wide?: boolean;
  maxWidth?: string;
  type?: "website" | "article";
}
const { title, description, image, wide = false, maxWidth, type = "website" } = Astro.props;
const resolvedMaxWidth = maxWidth ?? (wide ? "1080px" : undefined);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(image ?? "/og-image.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="alternate" type="application/rss+xml" title="Vivek's Weblog" href="/rss.xml" />
    <title>{title}</title>

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Vivek's Weblog" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageUrl} />

    <ClientRouter />

    <script is:inline>
      // Runs before paint to avoid a flash of the wrong theme. Explicit
      // choice (localStorage) wins; otherwise no data-theme is set at all,
      // so the CSS media-query default (prefers-color-scheme) applies.
      function applyStoredTheme(root) {
        const storedTheme = localStorage.getItem("theme");
        if (storedTheme === "light" || storedTheme === "dark") {
          root.setAttribute("data-theme", storedTheme);
        }
      }
      applyStoredTheme(document.documentElement);
      // ClientRouter swaps in a fresh document on client-side navigation,
      // which has no data-theme attribute — without this it would revert
      // to the system default until the next full page reload.
      document.addEventListener("astro:before-swap", (event) => {
        applyStoredTheme(event.newDocument.documentElement);
      });
    </script>
  </head>
  <body>
    <Navbar />
    <div class="site" style={resolvedMaxWidth ? `--site-max-width: ${resolvedMaxWidth}` : undefined}>
      <slot />
    </div>
    <Footer />
    <CopyCodeButtons />
  </body>
</html>
