---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
  maxWidth?: string;
}
const { title, description, wide = false, maxWidth } = Astro.props;
const resolvedMaxWidth = maxWidth ?? (wide ? "1080px" : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
  </head>
  <body>
    <Navbar />
    <div class="site" style={resolvedMaxWidth ? `--site-max-width: ${resolvedMaxWidth}` : undefined}>
      <slot />
    </div>
    <Footer />
  </body>
</html>
