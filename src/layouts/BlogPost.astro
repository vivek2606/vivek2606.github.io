---
import Base from "./Base.astro";
import PostMeta from "../components/PostMeta.astro";
import TagPills from "../components/TagPills.astro";
import AuthorCard from "../components/AuthorCard.astro";

interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  author: string;
  readingTime: number;
}
const { title, description, date, tags, author, readingTime } = Astro.props;
---

<Base title={`${title} · Vivek Raj`} description={description} wide>
  <div class="post-layout">
    <article class="post">
      <h1>{title}</h1>
      <PostMeta date={date} author={author} readingTime={readingTime} />
      <p class="post-description">{description}</p>
      <TagPills tags={tags} />
      <div class="post-content">
        <slot />
      </div>
    </article>
    <AuthorCard />
  </div>
</Base>
