---
import type { CollectionEntry } from "astro:content";
import Base from "./Base.astro";
import PostMeta from "../components/PostMeta.astro";
import TagPills from "../components/TagPills.astro";
import AuthorCard from "../components/AuthorCard.astro";
import Comments from "../components/Comments.astro";

interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  author: string;
  readingTime: number;
  previousPost?: CollectionEntry<"blog">;
  nextPost?: CollectionEntry<"blog">;
  related: CollectionEntry<"blog">[];
}
const { title, description, date, tags, author, readingTime, previousPost, nextPost, related } =
  Astro.props;

const postUrl = new URL(Astro.url.pathname, Astro.site);
const tweetHref = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(postUrl.toString())}`;
---

<Base title={`${title} · Vivek's Weblog`} description={description} wide type="article">
  <div class="post-layout">
    <article class="post">
      <h1>{title}</h1>
      <PostMeta date={date} author={author} readingTime={readingTime} />
      <p class="post-description">{description}</p>
      <TagPills tags={tags} />
      <a class="share-link" href={tweetHref} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
        </svg>
        Share on X
      </a>
      <div class="post-content">
        <slot />
      </div>

      {
        (previousPost || nextPost) && (
          <nav class="post-nav" aria-label="Post navigation">
            {previousPost ? (
              <a class="post-nav__link post-nav__link--prev" href={`/blog/${previousPost.slug}/`}>
                <span class="post-nav__label">← Previous</span>
                <span class="post-nav__title">{previousPost.data.title}</span>
              </a>
            ) : (
              <span />
            )}
            {nextPost && (
              <a class="post-nav__link post-nav__link--next" href={`/blog/${nextPost.slug}/`}>
                <span class="post-nav__label">Next →</span>
                <span class="post-nav__title">{nextPost.data.title}</span>
              </a>
            )}
          </nav>
        )
      }

      {
        related.length > 0 && (
          <section class="related-posts">
            <h2 class="related-posts__heading">Related posts</h2>
            <ul class="related-posts__list">
              {related.map((post) => (
                <li>
                  <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <Comments />
    </article>
    <AuthorCard />
  </div>
</Base>
